{
  "name": "fargjakten",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Färgjakten – ett voxel-färgspel för hemmanätverket",
  "scripts": {
    "build": "esbuild client/src/main.js --bundle --minify --sourcemap --target=safari15 --outfile=public/game.js",
    "start": "node server/index.js",
    "dev": "npm run build && node server/index.js",
    "check": "node scripts/check.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=24"
  }
}
